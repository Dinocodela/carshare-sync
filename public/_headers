/*
  # Prevent the site from being embedded in iframes (clickjacking).
  X-Frame-Options: DENY
  # Block MIME-type sniffing.
  X-Content-Type-Options: nosniff
  # Limit referrer information sent to third parties.
  Referrer-Policy: strict-origin-when-cross-origin
  # Enforce HTTPS for 2 years, including subdomains.
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  # Restrict powerful browser features to what the app actually needs.
  Permissions-Policy: geolocation=(self), camera=(self), microphone=(), payment=(self), usb=(), interest-cohort=()
  # Clickjacking protection via CSP (frame-ancestors is the modern equivalent of X-Frame-Options).
  Content-Security-Policy: frame-ancestors 'none'; upgrade-insecure-requests; base-uri 'self'; object-src 'none'
